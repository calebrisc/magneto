/* Two SINGLE-ENDED SAADC channels for one AAT003-10E-EVB01.
 *
 * Reality check vs the original differential plan: the EVB01 breakout
 * exposes single-ended half-bridge outputs only (card: Pin2=Cos, Pin5=Sin,
 * Pins 3/4=GND, Pins 1/6=Vdd) - there are no SIN-/COS- pins. Outputs sit
 * at mid-rail (~Vdd/2) with the signal swing on top, so:
 *
 * ch0: AIN0 (P1.04) = Sin      ch1: AIN2 (P1.06) = Cos
 * gain 1/4 against the 0.9 V internal reference -> 0..3.6 V input range,
 * which fits the ~1.65 V +/- 0.33 V signal with margin (0.88 mV/LSB).
 *
 * 40 us acquisition time kept: AAT003 source impedance is ~40 kOhm and
 * the SAADC sample cap needs the long setting to settle through it.
 */

#include <dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>;
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN2>;
		zephyr,resolution = <12>;
	};
};
